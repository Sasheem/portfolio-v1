---
interface Props {
    nav: { path: string; text: string }[];
}

import Sun from "@lucide/astro/icons/sun";
import Moon from "@lucide/astro/icons/moon";

const { nav } = Astro.props as Props;
---

<header class="py-6 flex items-center justify-between flex-col md:flex-row sticky top-0 bg-background/80 backdrop-blur-md z-40 w-full border-b border-transparent transition-colors duration-300">
    <div class="flex items-center gap-5 order-2 md:order-1">
        {
            nav.map((item) => (
                <a
                    class="opacity-50 transition-all duration-200 hover:opacity-100 text-[1rem] md:text-[0.85rem]"
                    href={item.path}
                >
                    {item.text}
                </a>
            ))
        }
    </div>
    <div class="order-1 md:order-2 mb-4 md:mb-0 space-x-2 md:space-x-0 w-full flex justify-end">
        <button
            id="theme-toggle"
            class="p-2 transition-all duration-200 hover:opacity-100 opacity-70 cursor-pointer"
            aria-label="Toggle dark mode"
        >
            <Sun class="hidden dark:block w-5 h-5 text-foreground" />
            <Moon class="block dark:hidden w-5 h-5 text-foreground" />
        </button>
    </div>
</header>
