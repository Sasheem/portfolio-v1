---
interface Props {
    status: string 
    id:string;
    email_url?: string ;
    github_url?: string ;
    linkedin_url?: string ;
}

const { status, email_url, github_url, linkedin_url, id } = Astro.props as Props
---

<footer
    id={id}
    class="my-24 border-t pt-8 px-4 text-sm grid grid-cols-1 gap-4 place-items-center"
>
    <div>
        <span
            class="inline-block w-2 h-2 rounded-full bg-primary mr-2 animate-pulse"
        ></span>
        <span class="opacity-70 uppercase">{status}</span>
        <span
            class="inline-block w-2 h-2 rounded-full bg-primary ml-2 animate-pulse"
        ></span>
    </div>
    <div class="flex gap-6 [&_a]:opacity-70 [&_a]:hover:opacity-100 [&_a]:hover:text-primary [&_a]:transition-colors [&_a]:duration-200">
        {email_url && (
            <a href={email_url}>
                Email
            </a>
        )}
        
        {github_url && (
            <a href={github_url} rel="nofollow" target="_blank">
                GitHub
            </a>
        )}

        {linkedin_url && (
            <a href={linkedin_url} rel="nofollow" target="_blank">
                LinkedIn
            </a>
        )}
    </div>
</footer>